# Flask
APP_SECRET_KEY=replace-with-a-long-random-value
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=0

# SQL Server
DB_SERVER=
DB_NAME=MedrikSupportAssistant
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=no
DB_USER=
DB_PASSWORD=

# Initial administrator (used only when the users table is empty)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_NAME=مدیر سیستم

# AI and retrieval
OPENAI_API_KEY=
OPENAI_RESPONSE_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=30
OPENAI_RETRY_COOLDOWN_SECONDS=60
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
KNOWLEDGE_CACHE_TTL_SECONDS=300
KNOWLEDGE_RETRIEVAL_MIN_SCORE=0.43
KNOWLEDGE_ANSWER_MIN_CONFIDENCE=0.68
KNOWLEDGE_OFFLINE_MIN_SCORE=0.68
